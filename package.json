{
  "name": "api-ui-test-suite",
  "version": "1.0.0",
  "description": "Automated API and UI test suite built with Playwright, Jest and TypeScript",
  "scripts": {
    "test": "playwright test",
    "test:api": "playwright test tests/api",
    "test:ui": "playwright test tests/ui",
    "test:unit": "jest",
    "test:headed": "playwright test --headed",
    "report": "playwright show-report"
  },
  "keywords": ["playwright", "jest", "typescript", "api-testing", "qa-automation"],
  "license": "MIT",
  "devDependencies": {
    "@playwright/test": "^1.49.0",
    "@types/jest": "^29.5.14",
    "@types/node": "^22.10.0",
    "jest": "^29.7.0",
    "ts-jest": "^29.2.5",
    "typescript": "^5.7.2"
  }
}
